\abx@aux@cite{0}{bhagat2025compressed}
\abx@aux@segm{0}{0}{bhagat2025compressed}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: SPD decomposition of the paired TMS model. Right: Softmax decomposition of the paired TMS model. Each input value is activated in isolation at magnitude 0.75. the top heatmap is the first layer W1 and the bottom heatmap is the second layer W2, with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible. SPD finds the correct structure of pairing features together but does not attribute one feature pair per subcomponent. Softmax achieves the desired importance decomposition, with the exception of one feature pair. SPD was trained with $200$ subcomponents and Softmax with $100$, as these yielded the best results for each method.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:both}{{2}{9}{Left: SPD decomposition of the paired TMS model. Right: Softmax decomposition of the paired TMS model. Each input value is activated in isolation at magnitude 0.75. the top heatmap is the first layer W1 and the bottom heatmap is the second layer W2, with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible. SPD finds the correct structure of pairing features together but does not attribute one feature pair per subcomponent. Softmax achieves the desired importance decomposition, with the exception of one feature pair. SPD was trained with $200$ subcomponents and Softmax with $100$, as these yielded the best results for each method}{figure.2}{}}
