\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Causal importance values for SPD across the minimality sweep, with each input activated in isolation at magnitude $0.75$ and the resulting importance over subcomponents. The panels correspond to $\beta _3$ values in $[10^{-3}, 10^{-5}, 10^{-6}]$, all at rank 1. Within each panel the top heatmap is the first layer $W_1$ (labelled linear1) and the bottom heatmap is the second layer $W_2$ (linear2), with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible, so the column index is not comparable across panels. The full sweep over $10^{-1}$ to $10^{-6}$ can be found in the appendix.}}{17}{figure.10}\protected@file@percent }
\newlabel{fig:spd_minimality_sweep_condensed}{{10}{17}{Causal importance values for SPD across the minimality sweep, with each input activated in isolation at magnitude $0.75$ and the resulting importance over subcomponents. The panels correspond to $\beta _3$ values in $[10^{-3}, 10^{-5}, 10^{-6}]$, all at rank 1. Within each panel the top heatmap is the first layer $W_1$ (labelled linear1) and the bottom heatmap is the second layer $W_2$ (linear2), with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible, so the column index is not comparable across panels. The full sweep over $10^{-1}$ to $10^{-6}$ can be found in the appendix}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Causal importance values for Softmax with attention across the minimality sweep, with each input activated in isolation at magnitude $0.75$ and the resulting importance over subcomponents. The panels correspond to $\beta _3$ values in $[10^{-3}, 10^{-5}, 10^{-6}]$, all at rank 1. Within each panel the top heatmap is the first layer $W_1$ (labelled linear1) and the bottom heatmap is the second layer $W_2$ (linear2), with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible, so the column index is not comparable across panels. The full sweep over $10^{-1}$ to $10^{-6}$ can be found in the appendix.}}{18}{figure.11}\protected@file@percent }
\newlabel{fig:softmax_minimality_sweep_condensed}{{11}{18}{Causal importance values for Softmax with attention across the minimality sweep, with each input activated in isolation at magnitude $0.75$ and the resulting importance over subcomponents. The panels correspond to $\beta _3$ values in $[10^{-3}, 10^{-5}, 10^{-6}]$, all at rank 1. Within each panel the top heatmap is the first layer $W_1$ (labelled linear1) and the bottom heatmap is the second layer $W_2$ (linear2), with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible, so the column index is not comparable across panels. The full sweep over $10^{-1}$ to $10^{-6}$ can be found in the appendix}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Overview of routing patterns for SPD and softmax with attention, with the rank fixed at $k=1$ and the minimality coefficient fixed varied over [$10^{-3},10^{-5},10^{-6}$] (left to right). Within each panel, only the subcomponents accounting for $80\%$ of the total $L_1$ norm in each layer are shown. The left edges, from each input group $g$ to a first-layer subcomponent $c$, give $\DOTSB \sum@ \slimits@ _{i=1}^{d_{\text  {hidden}}} \rho ^{l}_{(c),[i,g]}$, the total contribution of group $g$ to subcomponent $c$ across all hidden neurons. The middle edges give the routing matrix $\Psi _{c',c}$, how strongly each first-layer subcomponent routes into each second-layer subcomponent. The right edges, from a second-layer subcomponent $c$ to each output $k$, give $\DOTSB \sum@ \slimits@ _{i=1}^{d_{\text  {hidden}}} \pi ^{l+1}_{(c),[k,i]}$, the total contribution of subcomponent $c$ to output $k$. Within each panel, edge widths are scaled to the largest edge in each of the three edge sets, so they are comparable within a set but not across sets or panels. The full sweep over $10^{-1}$ to $10^{-6}$ for both methods can be found in the appendix.}}{19}{figure.12}\protected@file@percent }
\newlabel{fig:softmax_spd_minimality_sweep_condensed}{{12}{19}{Overview of routing patterns for SPD and softmax with attention, with the rank fixed at $k=1$ and the minimality coefficient fixed varied over [$10^{-3},10^{-5},10^{-6}$] (left to right). Within each panel, only the subcomponents accounting for $80\%$ of the total $L_1$ norm in each layer are shown. The left edges, from each input group $g$ to a first-layer subcomponent $c$, give $\sum _{i=1}^{d_{\text {hidden}}} \rho ^{l}_{(c),[i,g]}$, the total contribution of group $g$ to subcomponent $c$ across all hidden neurons. The middle edges give the routing matrix $\Psi _{c',c}$, how strongly each first-layer subcomponent routes into each second-layer subcomponent. The right edges, from a second-layer subcomponent $c$ to each output $k$, give $\sum _{i=1}^{d_{\text {hidden}}} \pi ^{l+1}_{(c),[k,i]}$, the total contribution of subcomponent $c$ to output $k$. Within each panel, edge widths are scaled to the largest edge in each of the three edge sets, so they are comparable within a set but not across sets or panels. The full sweep over $10^{-1}$ to $10^{-6}$ for both methods can be found in the appendix}{figure.12}{}}
