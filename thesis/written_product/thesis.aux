\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Decomposition of $\mathrm  {TMS}_{5\text  {-}2}$ using RSPD. The first two panels show the target model's weight columns and the sum of learned subcomponents. Subsequent panels show the individual subcomponents, ordered by decreasing norm. Although $20$ subcomponents are allocated, only the first $5$ carry large norm and contribute predominantly to the reconstruction. Each active subcomponent recovers primarily one feature direction. with minor leakage across components.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:tms_5_2}{{1}{7}{Decomposition of $\mathrm {TMS}_{5\text {-}2}$ using RSPD. The first two panels show the target model's weight columns and the sum of learned subcomponents. Subsequent panels show the individual subcomponents, ordered by decreasing norm. Although $20$ subcomponents are allocated, only the first $5$ carry large norm and contribute predominantly to the reconstruction. Each active subcomponent recovers primarily one feature direction. with minor leakage across components}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Decomposition quality across both TMS regimes. SPD refers to the original method \blx@tocontentsinit {0}\autocite {stochasticparameterdecomposition}; RSPD refers to the relational importance function of Section~\ref {sec:rank-k-attention}. If the standard deviation is not reported, it is due to it being smaller than $0.001$.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:tms_results_single}{{2}{7}{Decomposition quality across both TMS regimes. SPD refers to the original method \autocite {stochasticparameterdecomposition}; RSPD refers to the relational importance function of Section~\ref {sec:rank-k-attention}. If the standard deviation is not reported, it is due to it being smaller than $0.001$}{table.2}{}}
