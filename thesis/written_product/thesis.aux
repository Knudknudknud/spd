\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Top: values of $s_{i}$. Middle: response $\rho _{l,[i,g]}$ from each input group to hidden neuron $i$. Bottom: contribution $\pi _{l+1,[k,i]}$ of each hidden neuron to each simplex's volume output. Neurons are ordered by $\rho _{l,[i,g]}$, then $s_i$, and lastly by output strength. Neurons with $s_{i} > 0.05$ shown.}}{16}{}\protected@file@percent }
\newlabel{fig:simplex_target_structure}{{10}{16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Group to output response $r_{g,k} = \DOTSB \sum@ \slimits@ _{i}^{d_{\text  {hidden}}} \pi _{l+1,[k,i]}\mathrm  {ReLU}\!\left (\rho _{l,[i,g]}\right )$ obtained by sampling each simplex in isolation and measuring the resulting volume output. The magnitude is concentrated on the diagonal, showing that each simplex strongly influences its own output, with negligible cross-activation.}}{16}{}\protected@file@percent }
\newlabel{fig:simplex_group_output}{{11}{16}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.4.2}Subcomponent structure}{17}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.4.3}Comparison of importance values across different minimality coefficients}{17}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Left to right: SPD sampled with one hot sampling, rank fixed at $k=1$, 50 subcomponents, 3 simplices for a total of 18 input features, with $\beta _3$ swept from $10^{-3}$ to $10^{-6}$. For the full sweep over minimality coefficients, see Appendix~\ref {appendix:SPD_minimality_sweep}.}}{18}{}\protected@file@percent }
\newlabel{fig:spd_minimality_sweep_condensed}{{12}{18}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Left to right: Softmax sampled with one hot sampling, rank fixed at $k=1$, 50 subcomponents, 3 simplices for a total of 18 input features, with $\beta _3$ swept from $10^{-3}$ to $10^{-6}$. Full sweep in the appendix.}}{20}{}\protected@file@percent }
\newlabel{fig:softmax_minimality_sweep_condensed}{{13}{20}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Left to right: edges: the group importance values given by $\rho _{i,g}$, $w_{2} \times w_{1}$: values given by. Edges are normalized within each layer, for each computation in isolation. The edge width do therefore not reflect importance between plots. Multiple large edges, thus suggest similar magnitudes, while one large edge and many small edges suggest a more concentrated structure. Each middle column has subcomponents such that they determine 95\% of the total magnitude. The columns are not sorted by magnitude.}}{21}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.4.4}Comparison of importance values across ranks at fixed minimality}{21}{}\protected@file@percent }
