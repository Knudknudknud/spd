\newlabel{fig:simplex_target_structure}{{8}{14}{Top:$\rho ^{l}_{[i,g]}$ from each input group to hidden neuron $i$. Bottom: contribution $\pi ^{l} _{[k,i]}$ of each hidden neuron to each simplex's volume output. Neurons are ordered by $\rho _{l,[i,g]}$, then $s_i$, and lastly by output strength. Only neurons that activate strongly for one simplex and one output are shown}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Group-to-output response of the trained network. Each entry $P_{g,k} = \tfrac  {1}{N}\DOTSB \sum@ \slimits@ _{n} \big  [\, W_2\,\mathrm  {ReLU}(W_1 x^{(g)}_n)\,\big  ]_k$ is the mean activation to output $k$ when only simplex $g$ is active in the input, averaged over 200 samples.}}{15}{figure.9}\protected@file@percent }
\newlabel{fig:simplex_group_output}{{9}{15}{Group-to-output response of the trained network. Each entry $P_{g,k} = \tfrac {1}{N}\sum _{n} \big [\, W_2\,\mathrm {ReLU}(W_1 x^{(g)}_n)\,\big ]_k$ is the mean activation to output $k$ when only simplex $g$ is active in the input, averaged over 200 samples}{figure.9}{}}
