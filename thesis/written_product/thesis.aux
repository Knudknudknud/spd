\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Top: values of $s_{i}$. Middle: response $\rho _{l,[i,g]}$ from each input group to hidden neuron $i$. Bottom: contribution $\pi _{l+1,[k,i]}$ of each hidden neuron to each simplex's volume output. Neurons are ordered by $\rho _{l,[i,g]}$, then $s_i$, and lastly by output strength. Neurons with $s_{i} > 0.05$ shown.}}{15}{figure.9}\protected@file@percent }
\newlabel{fig:simplex_target_structure}{{9}{15}{Top: values of $s_{i}$. Middle: response $\rho _{l,[i,g]}$ from each input group to hidden neuron $i$. Bottom: contribution $\pi _{l+1,[k,i]}$ of each hidden neuron to each simplex's volume output. Neurons are ordered by $\rho _{l,[i,g]}$, then $s_i$, and lastly by output strength. Neurons with $s_{i} > 0.05$ shown}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Group to output response $r_{g,k} = \DOTSB \sum@ \slimits@ _{i}^{d_{\text  {hidden}}} \pi _{l+1,[k,i]}\mathrm  {ReLU}\!\left (\rho _{l,[i,g]}\right )$ obtained by sampling each simplex in isolation and measuring the resulting volume output. The magnitude is concentrated on the diagonal, showing that each simplex strongly influences its own output, with negligible cross-activation.}}{15}{figure.10}\protected@file@percent }
\newlabel{fig:simplex_group_output}{{10}{15}{Group to output response $r_{g,k} = \sum _{i}^{d_{\text {hidden}}} \pi _{l+1,[k,i]}\mathrm {ReLU}\!\left (\rho _{l,[i,g]}\right )$ obtained by sampling each simplex in isolation and measuring the resulting volume output. The magnitude is concentrated on the diagonal, showing that each simplex strongly influences its own output, with negligible cross-activation}{figure.10}{}}
