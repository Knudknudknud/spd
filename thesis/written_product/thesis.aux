\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: Softmax. Right: SPD. Pairwise cosine similarity between the $U_c$ and $V_c$ vectors of the causally important subcomponents for both layers. Subcomponents are ordered by decreasing norm.}}{13}{}\protected@file@percent }
