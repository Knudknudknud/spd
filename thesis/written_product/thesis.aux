\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cosine similarity between encoder columns $W_{:,i}$ and $W_{:,j}$, where $i$ and $j$ index inputs. Within-group reports the similarity between the two columns of the same pair, and across-group the similarity between columns of different pairs.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:tms-paired-cosine-similarity}{{3}{8}{Cosine similarity between encoder columns $W_{:,i}$ and $W_{:,j}$, where $i$ and $j$ index inputs. Within-group reports the similarity between the two columns of the same pair, and across-group the similarity between columns of different pairs}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: SPD decomposition of the paired TMS model. Right: RSPD decomposition of the paired TMS model. Each input value is activated in isolation at magnitude 0.75. Despite the model learning $W=W^{T}$, two sets of subcomponents are leafnt, one for each layer.The top heatmap is the first layer and the bottom heatmap is the second layer , with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible. SPD was trained with $200$ subcomponents and RSPD with $100$, as these yielded the best results for each method.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:both}{{2}{8}{Left: SPD decomposition of the paired TMS model. Right: RSPD decomposition of the paired TMS model. Each input value is activated in isolation at magnitude 0.75. Despite the model learning $W=W^{T}$, two sets of subcomponents are leafnt, one for each layer.The top heatmap is the first layer and the bottom heatmap is the second layer , with rows corresponding to the subcompoent index and columns corresponding to the causal importance value. The subcomponents are permuted within each panel to make the block structure visible. SPD was trained with $200$ subcomponents and RSPD with $100$, as these yielded the best results for each method}{figure.2}{}}
